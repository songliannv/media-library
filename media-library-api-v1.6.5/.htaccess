# 媒资资料库 · Apache 重写与安全规则
# ------------------------------------------------------------------
# 本文件只对 Apache 生效；Nginx 环境请改用宝塔「伪静态」里的规则
# （见 DEPLOY.md 第五节，或后台自检报告里的提示）。

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 真实存在的文件/目录直接返回（/uisc/xxx.html 等静态页不进 PHP）
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php [QSA,L]

  # 网页安装器 install.php：放行，由它自己判定（已安装 → 主动 404；未安装 → 安装向导）
  # 注意这条必须排在下面的安装路径黑洞**之前**。
  RewriteRule ^install\.(php)?$ - [L]

  # 安装路径黑洞：其余 install / setup / upgrade / update 类路径一律 404
  RewriteRule ^(install|setup|upgrade|update)([._-][a-z0-9]+)?(\.[a-z0-9]+)?(/.*)?$ - [R=404,L]
</IfModule>

# 保护敏感目录（配置 / SQL / 源码 / 定时脚本 / 工具 / 备份）
RedirectMatch 404 ^/(config|sql|cron|core|adapters|tools|data|logs|backup)/

# 禁止下载源码、SQL、文档、备份与锁文件
<FilesMatch "\.(sql|md|lock|bak|bak[0-9]*|ini|log|env|sh|bash|yml|yaml|conf|dist|sample|swp|swo|orig|save|old|tmp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 禁止访问点文件（.git / .env / .htaccess 等）
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
